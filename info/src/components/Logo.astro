      <path d="M16.5 24L18.8 26.3L23.5 21.6" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <span class="font-['Hanken_Grotesk'] text-[19px] font-black tracking-tight text-[#111111]">
    VPN <span class="text-[#614abf]">Good Choice</span>
  </span>
