---
// Same brand mark as src/components/Logo.tsx in the main app, hand-ported
// since this is a separate Astro project (no shared component tooling).
---

<a href="/" class="flex items-center gap-2.5 select-none group">
  <span class="relative w-8 h-8 flex items-center justify-center shrink-0">
    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
      <defs>
        <linearGradient id="vgcShieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#614abf" />
          <stop offset="50%" stop-color="#7e65e6" />
          <stop offset="100%" stop-color="#432c9e" />
        </linearGradient>
        <linearGradient id="vgcCheckGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#00E676" />
          <stop offset="100%" stop-color="#00C853" />
