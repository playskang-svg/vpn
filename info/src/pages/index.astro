---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

const TAG_LABELS: Record<string, string> = {
  'china-vpn': '중국 VPN',
  'free-vpn': '무료 VPN',
  'streaming': '스트리밍',
  'korea-abroad-services': '해외에서 한국 서비스',
  'study-work-abroad': '유학·워킹홀리데이',
  'troubleshooting': '문제 해결',
  'vpn-comparison': 'VPN 비교',
  'guides-basics': '기초 가이드',
};
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const orderedTags = Object.keys(TAG_LABELS).filter((t) => tagCounts.has(t));
---

<BaseLayout
  title="정보 & 가이드"
  description="VPN, 디지털 프라이버시, 온라인 보안에 관한 실용적인 가이드와 정보를 모았습니다."
  path="/info/"
  breadcrumbs={[
    { name: 'VPN Good Choice', path: '/' },
    { name: '정보 & 가이드', path: '/info/' },
  ]}
>
  <h1 class="font-['Hanken_Grotesk'] text-[32px] sm:text-[40px] font-extrabold text-[#111111] mb-3 tracking-tight">
    정보 & 가이드
  </h1>
  <p class="text-[#444748] text-[16px] leading-relaxed mb-6">
    VPN과 디지털 프라이버시, 온라인 보안에 대해 알아두면 좋은 내용들을 정리했습니다.
  </p>

  <div id="tag-filters" class="flex flex-wrap gap-2 mb-8">
    <button type="button" data-tag="all" class="tag-pill is-active">
      전체 {posts.length}
    </button>
    {orderedTags.map((tag) => (
      <button type="button" data-tag={tag} class="tag-pill">
        {TAG_LABELS[tag]} {tagCounts.get(tag)}
      </button>
    ))}
  </div>

  <p id="no-results" class="hidden text-[#747878] text-[15px] py-10 text-center">
    해당 카테고리의 글이 아직 없습니다.
  </p>

  <div class="flex flex-col divide-y divide-[#E0E0E0]">
    {posts.map((post) => (
      <a
        href={`/info/${post.id}/`}
        data-tags={post.data.tags.join(',')}
        class="post-item group py-6 first:pt-0 flex flex-col sm:flex-row gap-5"
      >
        <img
          src={post.data.thumbnail}
          alt=""
          loading="lazy"
          class="w-full sm:w-48 aspect-[1200/630] object-contain bg-[#5b46b0] rounded-xl border border-[#E0E0E0] shrink-0"
          width="1200"
          height="630"
        />
        <div class="flex flex-col gap-2 min-w-0">
          <span class="text-xs font-semibold text-[#747878] uppercase tracking-wide">
            {dateFmt.format(post.data.date)}
          </span>
          <h2 class="font-['Hanken_Grotesk'] text-[22px] font-bold text-[#111111] group-hover:text-[#614abf] transition-colors">
            {post.data.title}
          </h2>
          <p class="text-[#444748] text-[15px] leading-relaxed">
            {post.data.description}
          </p>
          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 mt-1">
              {post.data.tags.map((tag) => (
                <span class="text-[11px] font-semibold text-[#614abf] bg-[#e6deff] px-2 py-0.5 rounded-full">
                  {TAG_LABELS[tag] ?? tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .tag-pill {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #E0E0E0;
    background: #ffffff;
    color: #444748;
    transition: color 0.15s, background-color 0.15s, border-color 0.15s;
  }
  .tag-pill:hover {
    border-color: #614abf;
    color: #614abf;
  }
  .tag-pill.is-active,
  .tag-pill.is-active:hover {
    border-color: #614abf;
    background: #614abf;
    color: #ffffff;
  }
</style>

<script>
  const filterBar = document.getElementById('tag-filters');
  const items = document.querySelectorAll<HTMLElement>('.post-item');
  const noResults = document.getElementById('no-results');

  filterBar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.tag-pill');
    if (!btn) return;
    const tag = btn.dataset.tag!;

    filterBar.querySelectorAll('.tag-pill').forEach((el) => el.classList.remove('is-active'));
    btn.classList.add('is-active');

    let visibleCount = 0;
    items.forEach((item) => {
      const tags = (item.dataset.tags ?? '').split(',');
      const show = tag === 'all' || tags.includes(tag);
      item.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });
    if (noResults) noResults.classList.toggle('hidden', visibleCount > 0);
  });
</script>
