---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });

const allPosts = await getCollection('posts');
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    overlap: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
  }))
  .filter((p) => p.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 4)
  .map((p) => p.post);

const aff = [
  { name: 'NordVPN', tag: '속도·균형 1위 추천', href: 'https://app.ac/jAw0hS593', color: '#4687ff' },
  { name: 'Surfshark', tag: '기기 무제한·가성비', href: 'https://app.ac/tAG6xw563', color: '#1ebeb4' },
  { name: 'ExpressVPN', tag: '초보자용 쉬운 앱', href: 'https://app.ac/ItVMzrM13', color: '#da3940' },
];

const breadcrumbs = [
  { name: 'VPN Good Choice', path: '/' },
  { name: '정보 & 가이드', path: '/info/' },
  { name: post.data.title, path: `/info/${post.id}/` },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/info/${post.id}/`}
  isArticle
  publishedDate={post.data.date}
  image={post.data.thumbnail}
  breadcrumbs={breadcrumbs}
>
  <a href="/info/" class="text-sm font-semibold text-[#614abf] hover:underline mb-6 inline-block">← 전체 글 목록</a>

  <article>
    <span class="text-xs font-semibold text-[#747878] uppercase tracking-wide">
      {dateFmt.format(post.data.date)}
    </span>
    <h1 class="font-['Hanken_Grotesk'] text-[28px] sm:text-[36px] font-extrabold text-[#111111] mt-2 mb-6 tracking-tight leading-tight">
      {post.data.title}
    </h1>

    <img
      src={post.data.thumbnail}
      alt={post.data.title}
      class="w-full h-auto rounded-2xl mb-8 border border-[#E0E0E0]"
      width="1200"
      height="630"
    />


    <div class="mb-8 rounded-2xl border border-[#d9d0ff] bg-[#f5f3ff] p-4">
      <p class="text-[13px] font-bold text-[#4930a6] mb-2">이 글 읽기 전, 공식 가격부터 확인하세요</p>
      <div class="grid grid-cols-3 gap-2">
        {aff.map((a) => (
          <a href={a.href} target="_blank" rel="sponsored noopener noreferrer" class="text-center rounded-lg bg-white border border-[#E0E0E0] hover:border-[#614abf] px-1 py-2.5 text-[13px] font-bold text-[#111111]">
            {a.name}<span class="block text-[10px] font-medium text-[#747878] mt-0.5">공식 가격 보기 →</span>
          </a>
        ))}
      </div>
      <p class="text-[11px] text-[#747878] mt-2">제휴 링크가 포함되어 있으며, 구매 시 운영자가 수수료를 받을 수 있어요(가격 변동 없음).</p>
    </div>

    <div class="prose-content text-[#1a1c1c] text-[16px] leading-[1.8]">
      <Content />
    </div>
  </article>

  {related.length > 0 && (
    <section class="mt-14 pt-10 border-t border-[#E0E0E0]">
      <h2 class="font-['Hanken_Grotesk'] text-[20px] font-bold text-[#111111] mb-5">관련 글</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {related.map((r) => (
          <a
            href={`/info/${r.id}/`}
            class="group flex gap-3 p-3 rounded-xl border border-[#E0E0E0] hover:border-[#614abf] transition-colors bg-white"
          >
            <img
              src={r.data.thumbnail}
              alt=""
              loading="lazy"
              class="w-24 sm:w-28 aspect-[1200/630] object-contain bg-[#5b46b0] rounded-lg shrink-0"
              width="1200"
              height="630"
            />
            <div class="flex flex-col justify-center min-w-0">
              <h3 class="text-[14px] font-bold text-[#111111] group-hover:text-[#614abf] transition-colors leading-snug line-clamp-3">
                {r.data.title}
              </h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="mt-12 pt-8 border-t border-[#E0E0E0] bg-[#e6deff] rounded-2xl p-6 text-center">
    <p class="text-[#4930a6] font-extrabold text-[18px] mb-1">읽었다면, 지금 가격만 확인해 보세요</p>
    <p class="text-[#4930a6] text-[13px] mb-4">공식 사이트 이동 후 플랜별 가격과 환불 보장 기간을 바로 볼 수 있어요.</p>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {aff.map((a) => (
        <a href={a.href} target="_blank" rel="sponsored noopener noreferrer" class="block rounded-xl bg-white border-2 border-[#614abf] hover:bg-[#614abf] hover:text-white text-[#4930a6] px-3 py-3 font-extrabold text-[15px] transition-colors">
          {a.name}<span class="block text-[11px] font-medium opacity-80 mt-0.5">{a.tag}</span><span class="block text-[12px] mt-1">가격 확인하기 →</span>
        </a>
      ))}
    </div>
    <p class="text-[12px] text-[#4930a6] mt-4">비용이 부담된다면 <a href={`https://landing.bizhelp.kr/vpn/?utm_source=vpn-adbles&utm_medium=article&utm_campaign=${post.id}`} target="_blank" rel="sponsored noopener" class="underline font-bold">VPN 구독 공유 서비스 가격 비교(광고) 보기</a></p>
    <p class="text-[11px] text-[#747878] mt-3">제휴·수익 고지: 이 페이지의 링크는 제휴(링크프라이스 등) 링크로, 구매 시 운영자가 일정 수수료를 받을 수 있으며 구매 가격은 달라지지 않습니다. 가격·프로모션은 수시로 바뀝니다.</p>
  </div>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: #111111;
    margin-top: 2em;
    margin-bottom: 0.6em;
  }
  .prose-content :global(h3) {
    font-family: 'Hanken Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #111111;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }
  .prose-content :global(p) {
    margin-bottom: 1.2em;
  }
  .prose-content :global(ul),
  .prose-content :global(ol) {
    margin: 1em 0 1.5em 1.5em;
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }
  .prose-content :global(ul) {
    list-style: disc;
  }
  .prose-content :global(ol) {
    list-style: decimal;
  }
  .prose-content :global(strong) {
    color: #111111;
    font-weight: 700;
  }
  .prose-content :global(a) {
    color: #614abf;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 15px;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .prose-content :global(th),
  .prose-content :global(td) {
    padding: 10px 16px;
    text-align: left;
    border: 1px solid #E0E0E0;
  }
  .prose-content :global(th) {
    background: #f5f3ff;
    color: #4930a6;
    font-weight: 700;
    white-space: nowrap;
  }
  .prose-content :global(td) {
    color: #1a1c1c;
  }
  .prose-content :global(tbody tr:nth-child(even) td) {
    background: #fafafa;
  }
</style>
